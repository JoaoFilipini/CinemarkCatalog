{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CinemarkCatalogDb"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "AWS": {
    "ServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "SqsQueueUrl": "http://localhost:4566/000000000000/film-events"
  },
  "Serilog": {
  "MinimumLevel": {
    "Default": "Information",
    "Override": { "Microsoft.AspNetCore": "Warning" }
  }
},
"Cache": { "DefaultTtlMinutes": 5 },
}
